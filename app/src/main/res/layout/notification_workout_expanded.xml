<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_shell"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Hero: icon + title + timer pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/notification_icon_circle">

            <ImageView
                android:id="@+id/iv_expanded_status_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/notification_status_icon"
                android:src="@drawable/ic_notification_workout" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_exercise_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bench Press"
                android:textColor="@color/notification_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_set_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Set 2 of 4"
                android:textColor="@color/notification_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_elapsed_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/notification_pill_elapsed"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="00:00"
            android:textColor="@color/notification_violet"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Single context line -->
    <TextView
        android:id="@+id/tv_context_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="60 kg × 10"
        android:textColor="@color/notification_text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Session progress (hidden during rest) -->
    <ProgressBar
        android:id="@+id/pb_workout_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/notification_progress_workout"
        android:visibility="gone" />

    <!-- Rest block: timer + bar only -->
    <LinearLayout
        android:id="@+id/ll_rest_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/notification_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_rest_timer_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="1:30"
            android:textColor="@color/notification_blue"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_rest_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/notification_progress_rest" />
    </LinearLayout>

    <!-- Compact stepper: one row weight + reps -->
    <LinearLayout
        android:id="@+id/ll_quick_stepper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/notification_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_weight_minus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/notification_stepper_btn"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/notification_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_weight_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="60 kg"
            android:textColor="@color/notification_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_weight_plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/notification_stepper_btn"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/notification_text_primary"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="#33FFFFFF"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/btn_reps_minus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/notification_stepper_btn"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/notification_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_reps_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="10"
            android:textColor="@color/notification_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_reps_plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/notification_stepper_btn"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/notification_text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Primary CTA -->
    <TextView
        android:id="@+id/btn_expanded_primary"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/notification_chip_primary"
        android:gravity="center"
        android:text="Complete set"
        android:textColor="@color/notification_bg"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Hidden stubs for action binding (never shown) -->
    <TextView
        android:id="@+id/btn_rest_plus_15"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/btn_rest_skip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/btn_pause_resume"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/btn_end_workout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/btn_prev_exercise"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/btn_skip_exercise"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/btn_add_set"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/btn_remove_set"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
