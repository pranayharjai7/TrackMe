<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121314"
    android:padding="12dp"
    android:orientation="vertical">

    <!-- Collapsed Header row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/iv_expanded_status_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FF5722"
            android:contentDescription="Status Icon"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/iv_expanded_status_icon"
            android:layout_toStartOf="@+id/btn_expanded_primary"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_expanded_workout_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workout Session"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_expanded_exercise_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bench Press · Set 2/4"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Dynamic Context-dependent primary action button -->
        <Button
            android:id="@+id/btn_expanded_primary"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:backgroundTint="#FF5722"
            android:text="Complete"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"/>
    </RelativeLayout>

    <!-- Workout Progress Bar Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_progress_bar_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workout Progress ██████░░░░ 60%"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:fontFamily="monospace"/>

        <ProgressBar
            android:id="@+id/pb_workout_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:progress="60"
            android:max="100"
            android:progressTint="#00E676"
            android:progressBackgroundTint="#37474F"/>

        <TextView
            android:id="@+id/tv_next_exercise_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Next: Incline Dumbbell Press"
            android:textColor="#90A4AE"
            android:textSize="11sp"
            android:fontFamily="sans-serif-condensed"/>
    </LinearLayout>

    <!-- Quick Rest Adjust Panel (visible during RESTING) -->
    <LinearLayout
        android:id="@+id/ll_rest_adjust_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A2230"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_rest_timer_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Rest remaining: 60s"
            android:textColor="#2196F3"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_rest_plus_15"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#37474F"
                android:text="+15s"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btn_rest_plus_30"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#37474F"
                android:text="+30s"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btn_rest_skip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#2196F3"
                android:text="Skip Rest"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Entry Logger Panel (visible during ACTIVE_SET or IDLE) -->
    <LinearLayout
        android:id="@+id/ll_quick_log_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1C1E"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Log Set"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Weight Adjusters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight: "
                android:textColor="#B0BEC5"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btn_weight_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:backgroundTint="#37474F"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:padding="0dp"/>

            <TextView
                android:id="@+id/tv_weight_val"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="60 kg"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_weight_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:backgroundTint="#37474F"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:padding="0dp"/>

            <!-- Reps Adjusters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   Reps: "
                android:textColor="#B0BEC5"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btn_reps_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:backgroundTint="#37474F"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:padding="0dp"/>

            <TextView
                android:id="@+id/tv_reps_val"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="10"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_reps_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:backgroundTint="#37474F"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:padding="0dp"/>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Save Set Button -->
            <Button
                android:id="@+id/btn_save_set"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#00E676"
                android:text="Save"
                android:textColor="#121314"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Workout Navigation and Session Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btn_prev_exercise"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="#37474F"
            android:text="Prev"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_skip_exercise"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="#37474F"
            android:text="Skip Ex"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_pause_resume"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="#607D8B"
            android:text="Pause"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_end_workout"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="#B71C1C"
            android:text="End Session"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
