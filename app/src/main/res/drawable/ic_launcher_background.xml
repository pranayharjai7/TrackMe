<?xml version="1.0" encoding="utf-8"?>
<!--
  Radial gradient background: bright violet at center fading to deep violet/indigo
  at the edges — gives the icon a polished "glow" look.
  Using aapt:attr inline gradient (supported API 24+, our adaptive icon target is 26+).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="60">
                <item android:offset="0.0" android:color="#7C3AED" />
                <item android:offset="0.6" android:color="#5B21B6" />
                <item android:offset="1.0" android:color="#2D0F80" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
